# Sentinel Environment Configuration
PORT=5000
MONGO_URI=mongodb://localhost:27017/sentinel
NODE_ENV=development

# Authentication & Security
JWT_SECRET=replace_with_a_secure_jwt_secret_min_32_chars
ALLOW_DEV_TOKENS=false

# LLM Advisor Configuration (Gemini 2.5 Flash)
LLM_PROVIDER=gemini
LLM_API_KEY=
LLM_MODEL=gemini-2.5-flash
LLM_MAX_CONCURRENCY=5
BENCHMARK_MODE=mock

# Automation & Periodic Sweeps
RECONCILIATION_INTERVAL_MINUTES=15
SUGGESTION_TTL_HOURS=24

# Frontend Configuration
VITE_API_URL=http://localhost:5000
